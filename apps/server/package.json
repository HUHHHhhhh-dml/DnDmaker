{
  "name": "@protocol-life/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Servidor local de PROTOCOL LIFE (Fastify + SQLite + Drizzle)",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "backup": "tsx src/backup-cli.ts",
    "restore": "tsx src/restore-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@protocol-life/shared": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
